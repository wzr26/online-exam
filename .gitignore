```gitignore
# =========================
# Node.js
# =========================
node_modules/
**/node_modules/

npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# =========================
# Java / Maven / Spring Boot
# =========================
target/
**/target/

*.class

# Maven
.mvn/timing.properties

# =========================
# Environment variables
# =========================
.env
.env.*
!.env.example

# =========================
# Logs
# =========================
*.log

# =========================
# IDE / Editors
# =========================
.vscode/
.idea/
*.iml
*.iws
*.ipr

# Vim
*.swp
*.swo

# =========================
# OS files
# =========================
.DS_Store
Thumbs.db
Desktop.ini

# =========================
# Java build / temporary files
# =========================
*.jar
*.war

# =========================
# Test / Coverage
# =========================
coverage/
```
